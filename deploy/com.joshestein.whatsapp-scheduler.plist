<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.joshestein.whatsapp-scheduler</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/whatsapp-scheduler</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DATA_DIR</key>
        <string>__HOME__/Library/Application Support/whatsapp-scheduler</string>
        <key>LISTEN_ADDR</key>
        <string>127.0.0.1:20648</string>
    </dict>

    <!-- Start at login, restart whenever the process exits. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Minimum seconds between restarts. Stops a crash loop from spinning. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/whatsapp-scheduler.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/whatsapp-scheduler.log</string>
</dict>
</plist>
